{
  "info": {
    "name": "Toll Plazas Between Two Pincodes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }],
  "item": [
    { "name": "Bengaluru -> Pune (success)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/toll-plazas", "body": { "mode": "raw", "raw": "{\n  \"sourcePincode\": \"560064\",\n  \"destinationPincode\": \"411045\"\n}" } } },
    { "name": "Delhi -> Bengaluru (success)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/toll-plazas", "body": { "mode": "raw", "raw": "{\n  \"sourcePincode\": \"110001\",\n  \"destinationPincode\": \"560001\"\n}" } } },
    { "name": "Same pincode (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/toll-plazas", "body": { "mode": "raw", "raw": "{\n  \"sourcePincode\": \"560001\",\n  \"destinationPincode\": \"560001\"\n}" } } },
    { "name": "Malformed pincode (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/toll-plazas", "body": { "mode": "raw", "raw": "{\n  \"sourcePincode\": \"12AB\",\n  \"destinationPincode\": \"560001\"\n}" } } },
    { "name": "Non-existent pincode (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/toll-plazas", "body": { "mode": "raw", "raw": "{\n  \"sourcePincode\": \"999999\",\n  \"destinationPincode\": \"560001\"\n}" } } },
    { "name": "Missing field (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/toll-plazas", "body": { "mode": "raw", "raw": "{\n  \"sourcePincode\": \"560001\"\n}" } } }
  ]
}
